<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Orders database model (orders + outbox), shared by the Orders API, which writes it, and
       the outbox relay, which reads the outbox. Both belong to the same service (A). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="17.0.0" />
  </ItemGroup>

</Project>
